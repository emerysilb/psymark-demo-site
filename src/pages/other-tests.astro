---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { STORE_URL, CTA, url } from '../consts';
import heroBird from '../assets/hero-bird.png';

// The four VMS bands. `edge` is written out as a full class string rather than
// built from the tier name, because Tailwind scans this file as text and never
// sees a class it has to concatenate at runtime.
const tiers = [
  {
    name: 'Proficient',
    note: 'Skills are where they should be. Nothing to do.',
    edge: 'border-tier-proficient',
  },
  {
    name: 'Emerging',
    note: 'Developing on track, worth a second screen later in the year.',
    edge: 'border-tier-emerging',
  },
  {
    name: 'Observation',
    note: 'Keep watching. Classroom supports before referral.',
    edge: 'border-tier-observation',
  },
  {
    name: 'Intervention',
    note: 'Refer for the full VMAT assessment.',
    edge: 'border-tier-intervention',
  },
];

// Figures, so they get `font-mono tabular`. `3-5` and `4-11` are the design's
// own notation and stay exactly as written.
const stats = [
  { label: 'Metrics per administration', value: '9' },
  { label: 'Minutes to screen with the VMS', value: '3-5' },
  { label: 'Standardized age range, VMAT', value: '4-11' },
];

const chooser = [
  {
    code: 'VMS',
    lead: 'You have a whole class and no idea who to look at first.',
    detail: 'Teachers and interventionists, three to five minutes per student.',
  },
  {
    code: 'VMAT',
    lead: 'You need a standardized score for an evaluation or an IEP.',
    detail: 'OTs and school psychologists, ages 4 to 11.',
    // The homepage IS the VMAT page, per consts.ts. The design pointed this at
    // the design-tool file name.
    link: { href: url('/'), label: 'See the VMAT' },
  },
  {
    code: 'VMP',
    lead: 'The goal is written and you have to show growth on it.',
    detail: 'Nine metrics, tracked term over term.',
  },
];
---

<Base
  title="Other Tests"
  description="The Visual Motor Screener sorts a class into four tiers in three to five minutes. Visual Motor Progress Monitoring tracks nine metrics across the year."
>
  <Header />

  <main id="main">
    <section class="border-b border-green-100 bg-green-50">
      <div
        class="psy-container grid items-center gap-[clamp(40px,6vw,80px)] pb-22 pt-20 md:grid-cols-[6fr_5fr]"
      >
        <div>
          <h1
            class="max-w-[20ch] text-[clamp(40px,4.6vw,60px)] font-extrabold leading-[1.06] tracking-[-0.03em] text-navy-700"
          >
            Two more ways to watch visual-motor skills.
          </h1>
          <p class="mt-[22px] max-w-[48ch] text-[19px] leading-relaxed text-slate-600">
            The VMAT is the standardized assessment. The Visual Motor Screener catches who needs a
            closer look, and Visual Motor Progress Monitoring shows whether intervention is working.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="#vms"
              class="inline-flex h-13 items-center rounded-md border border-slate-300 bg-white px-7 text-[17px] font-semibold text-navy-700 transition-colors hover:border-navy-300 hover:text-navy-800"
            >
              See the VMS
            </a>
            <a
              href="#vmp"
              class="inline-flex h-13 items-center rounded-md border border-slate-300 bg-white px-7 text-[17px] font-semibold text-navy-700 transition-colors hover:border-navy-300 hover:text-navy-800"
            >
              See the VMP
            </a>
          </div>
        </div>
        <Image
          src={heroBird}
          alt=""
          aria-hidden="true"
          widths={[320, 420, 840]}
          sizes="(min-width: 768px) 420px, 100vw"
          class="block w-full max-w-[420px] justify-self-end"
        />
      </div>
    </section>

    {/* scroll-mt clears the sticky header, which would otherwise cover the
        heading when the hero's #vms and #vmp buttons jump here. */}
    <section id="vms" class="psy-container scroll-mt-24 py-26">
      <div data-reveal>
        <div class="flex items-baseline gap-4">
          <span
            class="font-mono text-[15px] font-semibold tracking-[0.04em] text-green-700">VMS</span
          >
          <h2
            class="text-[clamp(30px,3.4vw,46px)] font-bold leading-[1.12] tracking-[-0.025em] text-navy-700"
          >
            Visual Motor Screener
          </h2>
        </div>
        <p class="mt-5 max-w-[60ch] text-[19px] leading-[1.65] text-slate-600">
          A three to five minute screen built for general-education teachers and interventionists.
          It answers one question: which students need a formal referral.
        </p>
      </div>

      <div class="mt-11 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          tiers.map((t) => (
            <div class:list={['border-t-[3px] pt-[18px]', t.edge]}>
              <div class="text-[19px] font-bold tracking-[-0.01em] text-navy-700">{t.name}</div>
              <p class="mt-2.5 text-[15px] leading-relaxed text-slate-600">{t.note}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-[15px] text-slate-500">
        Every student lands in one of four tiers. No scoring key, no interpretation call in the
        hallway.
      </p>
    </section>

    <section id="vmp" class="scroll-mt-24 bg-navy-700">
      <div
        class="psy-container grid items-center gap-[clamp(40px,6vw,80px)] py-26 md:grid-cols-[6fr_5fr]"
      >
        <div>
          <div class="flex items-baseline gap-4">
            <span
              class="font-mono text-[15px] font-semibold tracking-[0.04em] text-green-300">VMP</span
            >
            <h2
              class="text-[clamp(30px,3.4vw,46px)] font-bold leading-[1.12] tracking-[-0.025em] text-white"
            >
              Visual Motor Progress Monitoring
            </h2>
          </div>
          <p class="mt-5 max-w-[52ch] text-[19px] leading-[1.65] text-white/78">
            Nine distinct visual-motor metrics, tracked across the year. Compare a student against
            their own baseline and show what the intervention actually changed.
          </p>
        </div>

        {/* 1px grid gap over a translucent white background draws the hairlines
            between rows, so there are no borders to round at the corners. */}
        <div class="grid gap-px overflow-hidden rounded-lg bg-white/14">
          {
            stats.map((s) => (
              <div class="flex items-baseline justify-between gap-4 bg-navy-800 px-6 py-[22px]">
                <span class="text-[16px] text-white/85">{s.label}</span>
                <span class="tabular font-mono text-[26px] font-semibold text-green-300">
                  {s.value}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-b border-slate-200 bg-slate-50">
      <div class="psy-container py-26">
        <h2
          class="max-w-[26ch] text-[clamp(28px,3vw,40px)] font-bold leading-[1.2] tracking-[-0.025em] text-navy-700"
        >
          Which one do you need?
        </h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            chooser.map((c) => (
              <div class="rounded-lg border border-slate-200 bg-white p-8 shadow-card">
                <div class="font-mono text-[14px] font-semibold tracking-[0.04em] text-green-700">
                  {c.code}
                </div>
                <p class="mt-3.5 text-[18px] leading-relaxed text-navy-700">{c.lead}</p>
                <p class="mt-3 text-[15px] leading-relaxed text-slate-500">
                  {c.detail}
                  {c.link && (
                    <Fragment>
                      {' '}
                      <a
                        href={c.link.href}
                        class="font-semibold text-green-700 hover:text-green-800"
                      >
                        {c.link.label}
                      </a>
                    </Fragment>
                  )}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Identical to the band on /help/. Kept verbatim so the two pages match. */}
    <section class="bg-green-700">
      <div class="psy-container flex flex-wrap items-center justify-between gap-8 py-22">
        <div>
          <h2
            class="max-w-[18ch] text-[clamp(30px,3.8vw,48px)] font-extrabold leading-[1.1] tracking-[-0.03em] text-white"
          >
            Your first hundred tests are free.
          </h2>
          <p class="mt-4 max-w-[46ch] text-[18px] leading-relaxed text-white/92">
            Enough to run it across a real caseload before deciding anything.
          </p>
        </div>
        <a
          href={STORE_URL}
          class="inline-flex h-14 flex-none items-center rounded-md bg-white px-8 text-[17px] font-semibold text-green-800 transition-colors hover:bg-green-50 active:scale-[0.98]"
        >
          {CTA.primary}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
