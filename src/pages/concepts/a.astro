---
/**
 * CONCEPT A: "The Clinical Standard"
 *
 * Positioning: VMAT is a real standardized instrument, a peer of the Beery VMI,
 * not an app. Sells to the skeptical veteran clinician and to district
 * purchasing. Evidence and defensibility lead; speed is a secondary benefit.
 *
 * Type: Switzer throughout. A neutral Swiss grotesque with enough authority to
 * carry score tables without feeling like a startup.
 * Palette: navy-dominant, emerald reserved for data and actions.
 * Theme: light, locked. No inverted sections.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { NAV, STORE_URL } from '../../consts';
import ipad from '../../assets/ipad-results.png';

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);
const [lead, ...rest] = testimonials;

const shifts = [
  {
    group: 'Administration',
    items: [
      ['One protocol, every time', 'The iPad presents identical stimuli in identical order, so results do not drift between examiners or sites.'],
      ['Minutes, not a session block', 'Most students finish well inside a single pull-out, which matters when the caseload is forty deep.'],
    ],
  },
  {
    group: 'Scoring and reporting',
    items: [
      ['Scored before you stand up', 'Automatic scoring removes the hand-scoring step and the subjectivity that comes with it.'],
      ['Language you can paste into the eval', 'Standard scores, percentile ranks and a written summary come out ready for the report.'],
    ],
  },
];
---

<Base
  title="Concept A"
  description="Concept A for the Psymark redesign: a clinical-standard direction that leads with defensibility, standardized administration and report-ready scoring."
  noindex
>
  <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
    <div class="mx-auto flex h-[68px] max-w-[1200px] items-center justify-between px-6">
      <a href="/concepts/" class="font-semibold tracking-tight text-navy">Psymark</a>
      <nav class="hidden items-center gap-8 md:flex">
        {NAV.map((n) => (
          <span class="text-[15px] text-slate transition-colors hover:text-navy">{n.label}</span>
        ))}
      </nav>
      <a
        href={STORE_URL}
        class="rounded-brand bg-emerald-ink px-4 py-2 text-[15px] font-medium text-white transition-transform active:scale-[0.98]"
      >
        Buy VMAT
      </a>
    </div>
  </header>

  <main id="main">
    {/* 1. HERO: asymmetric split, 7/5 ------------------------------------- */}
    <section class="mx-auto max-w-[1200px] px-6 pt-16 pb-20 md:pt-24">
      <div class="grid items-center gap-12 md:grid-cols-12">
        <div class="md:col-span-7">
          <h1 class="font-sans text-4xl font-bold leading-[1.05] tracking-tight text-navy md:text-6xl">
            The visual-motor test<br />that scores itself.
          </h1>
          <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-slate">
            A standardized visual-motor assessment for iPad. Scores and a written
            report before the student leaves the room.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a
              href={STORE_URL}
              class="rounded-brand bg-emerald-ink px-6 py-3 font-medium text-white shadow-card transition-transform active:scale-[0.98]"
            >
              Buy VMAT
            </a>
            <a
              href="#report"
              class="rounded-brand border border-line px-6 py-3 font-medium text-navy transition-colors hover:border-navy"
            >
              See how it scores
            </a>
          </div>
        </div>
        <div class="md:col-span-5">
          <Image
            src={ipad}
            alt="VMAT results screen on iPad showing a normal curve with the student's standard score plotted against post-COVID norms."
            widths={[380, 520, 760]}
            sizes="(max-width: 768px) 90vw, 420px"
            loading="eager"
            class="w-full rounded-brand shadow-lift"
          />
        </div>
      </div>
    </section>

    {/* 2. THE SHIFT: grouped clusters, hairlines only, no cards ------------ */}
    <section class="border-y border-line bg-mist">
      <div class="mx-auto max-w-[1200px] px-6 py-20">
        <h2 class="max-w-[20ch] font-sans text-3xl font-bold tracking-tight text-navy md:text-4xl">
          What changes when the test is digital
        </h2>
        <div class="mt-14 grid gap-14 md:grid-cols-2 md:gap-20">
          {shifts.map((cluster) => (
            <div data-reveal>
              <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-emerald-ink">
                {cluster.group}
              </h3>
              <dl class="mt-6 space-y-8">
                {cluster.items.map(([term, detail]) => (
                  <div class="border-t border-line pt-5">
                    <dt class="text-lg font-semibold text-navy">{term}</dt>
                    <dd class="mt-2 max-w-[52ch] leading-relaxed text-slate">{detail}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 3. THE REPORT: 4-item bento, 4 cells, varied backgrounds ------------ */}
    <section id="report" class="mx-auto max-w-[1200px] px-6 py-24">
      <h2 class="max-w-[24ch] font-sans text-3xl font-bold tracking-tight text-navy md:text-4xl">
        Everything the report already contains
      </h2>

      <div class="mt-12 grid gap-4 md:grid-cols-5">
        <div
          class="flex flex-col justify-between gap-8 rounded-brand bg-emerald-wash p-8 md:col-span-3 md:row-span-2"
          data-reveal
        >
          <p class="max-w-[30ch] text-2xl font-semibold leading-snug text-navy md:text-[26px]">
            Norms collected after 2020, not carried forward from a sample that
            predates the disruption you are testing around.
          </p>
          <p class="max-w-[42ch] leading-relaxed text-slate">
            A student assessed today is compared against students assessed today.
            That is the difference between a score you cite and a score you caveat.
          </p>
        </div>

        <div class="rounded-brand border border-line bg-paper p-8 md:col-span-2" data-reveal>
          <p class="tabular text-4xl font-bold text-navy">Standard scores</p>
          <p class="mt-3 leading-relaxed text-slate">
            With percentile ranks and the normal curve, plotted for the eval.
          </p>
        </div>

        <div class="rounded-brand bg-navy p-8 md:col-span-2" data-reveal>
          <p class="text-4xl font-bold text-white">Goal bank</p>
          <p class="mt-3 leading-relaxed text-white/70">
            Evidence-based goals and intervention strategies, matched to the result.
          </p>
        </div>

        <div
          class="flex flex-col justify-between gap-6 rounded-brand border border-line bg-paper p-8 md:col-span-5 md:flex-row md:items-center"
          data-reveal
        >
          <p class="max-w-[40ch] text-xl font-semibold text-navy">
            The written summary comes out of the iPad, not out of your evening.
          </p>
          <a
            href={STORE_URL}
            class="shrink-0 rounded-brand bg-emerald-ink px-6 py-3 font-medium text-white transition-transform active:scale-[0.98]"
          >
            Buy VMAT
          </a>
        </div>
      </div>
    </section>

    {/* 4. TESTIMONIALS: one lead + supporting, not three equal cards ------- */}
    <section class="border-t border-line bg-mist">
      <div class="mx-auto max-w-[1200px] px-6 py-24">
        <div class="grid gap-12 md:grid-cols-12 md:gap-16">
          <figure class="md:col-span-6">
            <blockquote class="font-sans text-2xl font-medium leading-snug text-navy md:text-[28px]">
              “{lead.data.quote}”
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4">
              {lead.data.photo && (
                <Image
                  src={lead.data.photo}
                  alt=""
                  width={52}
                  height={52}
                  class="h-13 w-13 rounded-full object-cover"
                />
              )}
              <span class="text-[15px] leading-tight">
                <span class="block font-semibold text-navy">{lead.data.name}</span>
                <span class="block text-slate">
                  {lead.data.role}, {lead.data.credentials}
                </span>
              </span>
            </figcaption>
          </figure>

          <div class="space-y-10 md:col-span-5 md:col-start-8">
            {rest.map((t) => (
              <figure class="border-t border-line pt-6">
                <blockquote class="leading-relaxed text-slate">“{t.data.quote}”</blockquote>
                <figcaption class="mt-4 text-sm">
                  <span class="font-semibold text-navy">{t.data.name}</span>
                  <span class="text-slate">
                    , {t.data.role}, {t.data.credentials}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* 5. CLOSE ------------------------------------------------------------ */}
    <section class="mx-auto max-w-[1200px] px-6 py-24">
      <div class="rounded-brand bg-navy px-8 py-16 text-center md:px-16">
        <h2 class="mx-auto max-w-[18ch] font-sans text-3xl font-bold tracking-tight text-white md:text-4xl">
          Run your first hundred tests free.
        </h2>
        <p class="mx-auto mt-5 max-w-[48ch] leading-relaxed text-white/70">
          Enough to try it across a real caseload before you decide anything.
        </p>
        <a
          href={STORE_URL}
          class="mt-9 inline-block rounded-brand bg-emerald px-7 py-3.5 font-semibold text-ink transition-transform active:scale-[0.98]"
        >
          Buy VMAT
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-[1200px] px-6 py-10 text-sm text-slate">
      Concept A of 3. Internal review only.
      <a href="/concepts/" class="ml-2 font-medium text-emerald-ink underline">Back to all concepts</a>
    </div>
  </footer>
</Base>
