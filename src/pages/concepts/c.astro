---
/**
 * CONCEPT C: "What The Paper Form Throws Away"
 *
 * Positioning: the strongest available argument against the incumbent. A paper
 * protocol keeps the finished drawing and discards everything about how it was
 * produced. Digital administration keeps both. Sells to the clinician who
 * already owns a Beery VMI and wants a reason to change.
 *
 * NOTE FOR REVIEW: the visible copy here only repeats claims the current site
 * already makes ("more diagnostic information than paper-and-pencil"). If VMAT
 * captures specific process data (stroke order, timing, hesitation), confirm the
 * specifics with Karen and this concept becomes considerably sharper.
 *
 * Type: Satoshi throughout, tabular figures for scores.
 * Palette: ink surface, emerald as the single signal colour.
 * Theme: dark, locked. Every section is dark.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { NAV, STORE_URL } from '../../consts';
import ipad from '../../assets/ipad-results.png';

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);
const lead = testimonials[0];

const kept = [
  ['The finished form', 'Both keep this. It is the only thing a paper protocol can keep.'],
  ['A score without a scorer', 'Automatic scoring means the number does not shift with who is holding the pen.'],
  ['A record that stays comparable', 'Identical administration makes this year measurable against last year.'],
];
---

<Base
  title="Concept C"
  description="Concept C for the Psymark redesign: a dark, argument-led direction built around what a paper visual-motor protocol discards and a digital one keeps."
  noindex
  bodyClass="font-geo bg-ink"
>
  <div class="min-h-screen bg-ink">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-ink/85 backdrop-blur">
      <div class="mx-auto flex h-[68px] max-w-[1160px] items-center justify-between px-6">
        <a href="/concepts/" class="font-bold tracking-tight text-white">Psymark</a>
        <nav class="hidden items-center gap-8 md:flex">
          {NAV.map((n) => (
            <span class="text-[15px] text-white/60 transition-colors hover:text-white">
              {n.label}
            </span>
          ))}
        </nav>
        <a
          href={STORE_URL}
          class="rounded-brand bg-emerald px-4 py-2 text-[15px] font-bold text-ink transition-transform active:scale-[0.98]"
        >
          Buy VMAT
        </a>
      </div>
    </header>

    <main id="main">
      {/* 1. HERO: editorial manifesto, centred by intent -------------------- */}
      <section class="mx-auto max-w-[1160px] px-6 pt-20 pb-24 text-center md:pt-24">
        <h1
          class="mx-auto max-w-[27ch] text-4xl font-black leading-[1.03] tracking-tight text-white md:text-[62px]"
        >
          Paper keeps the drawing.<br />
          <span class="text-emerald">It loses everything else.</span>
        </h1>
        <p class="mx-auto mt-7 max-w-[54ch] text-lg leading-relaxed text-white/65">
          VMAT is a standardized visual-motor assessment for iPad, built to
          return more than a hand-scored form can.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href={STORE_URL}
            class="rounded-brand bg-emerald px-7 py-3.5 font-bold text-ink transition-transform active:scale-[0.98]"
          >
            Buy VMAT
          </a>
          <a
            href="#kept"
            class="rounded-brand border border-white/20 px-7 py-3.5 font-semibold text-white transition-colors hover:border-white/50"
          >
            See how it scores
          </a>
        </div>
      </section>

      {/* 2. THE PRODUCT, LARGE --------------------------------------------- */}
      <section class="mx-auto max-w-[1160px] px-6 pb-24">
        <div class="overflow-hidden rounded-brand border border-white/10 bg-navy-deep">
          <div class="grid items-center gap-10 p-8 md:grid-cols-12 md:p-14">
            <div class="md:col-span-5">
              <Image
                src={ipad}
                alt="The VMAT results screen: a normal curve with the student's standard score marked, above a table of percentile ranks."
                widths={[380, 520, 760]}
                sizes="(max-width: 768px) 80vw, 380px"
                loading="eager"
                class="w-full rounded-brand shadow-lift"
              />
            </div>
            <div class="md:col-span-6 md:col-start-7">
              <h2 class="text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl">
                The score is finished before the session is.
              </h2>
              <p class="mt-5 max-w-[48ch] leading-relaxed text-white/65">
                Standard scores, percentile ranks and the normal curve are
                generated as the student works, then handed over as a written
                summary you can move into the evaluation.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* 3. WHAT SURVIVES: hairline rows, 3 items --------------------------- */}
      <section id="kept" class="border-t border-white/10">
        <div class="mx-auto max-w-[1160px] px-6 py-24">
          <h2 class="max-w-[20ch] text-3xl font-bold tracking-tight text-white md:text-4xl">
            What survives the session
          </h2>
          <div class="mt-14">
            {kept.map(([term, detail]) => (
              <div
                class="grid gap-3 border-t border-white/10 py-8 md:grid-cols-12 md:gap-10"
                data-reveal
              >
                <h3 class="text-xl font-bold text-emerald md:col-span-4">{term}</h3>
                <p class="max-w-[56ch] leading-relaxed text-white/65 md:col-span-8">{detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* 4. SINGLE QUOTE, LARGE -------------------------------------------- */}
      <section class="border-t border-white/10">
        <div class="mx-auto max-w-[1160px] px-6 py-24">
          <figure>
            <blockquote
              class="max-w-[24ch] text-3xl font-bold leading-[1.15] tracking-tight text-white md:text-5xl"
            >
              “{lead.data.quote}”
            </blockquote>
            <figcaption class="mt-10 flex items-center gap-4">
              {lead.data.photo && (
                <Image
                  src={lead.data.photo}
                  alt=""
                  width={48}
                  height={48}
                  class="h-12 w-12 rounded-full object-cover"
                />
              )}
              <span class="text-[15px] leading-tight">
                <span class="block font-bold text-white">{lead.data.name}</span>
                <span class="block text-white/55">
                  {lead.data.role}, {lead.data.credentials}, {lead.data.location}
                </span>
              </span>
            </figcaption>
          </figure>
        </div>
      </section>

      {/* 5. CLOSE ----------------------------------------------------------- */}
      <section class="border-t border-white/10">
        <div class="mx-auto max-w-[1160px] px-6 py-24 text-center">
          <h2 class="mx-auto max-w-[20ch] text-3xl font-black tracking-tight text-white md:text-5xl">
            Run a hundred tests before you decide.
          </h2>
          <a
            href={STORE_URL}
            class="mt-9 inline-block rounded-brand bg-emerald px-8 py-4 font-bold text-ink transition-transform active:scale-[0.98]"
          >
            Buy VMAT
          </a>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/10">
      <div class="mx-auto max-w-[1160px] px-6 py-10 text-sm text-white/50">
        Concept C of 3. Internal review only.
        <a href="/concepts/" class="ml-2 font-medium text-emerald underline">Back to all concepts</a>
      </div>
    </footer>
  </div>
</Base>
