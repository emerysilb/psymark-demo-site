---
/**
 * CONCEPT B: "The Evening Back"
 *
 * Positioning: leads with the practitioner's actual problem. Caseloads, hand
 * scoring, and writing evaluations after hours. The product is time returned.
 * Sells to the individual OT or school psych spending their own PD budget.
 *
 * Type: Cabinet Grotesk for display, General Sans for body. Warmer and more
 * human than Concept A without becoming consumer-soft.
 * Palette: emerald-forward with navy as the text colour.
 * Theme: light, locked.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { NAV, STORE_URL } from '../../consts';
import ipad from '../../assets/ipad-results.png';

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order
);

const beats = [
  {
    title: 'You administer it',
    body: 'The student draws on the iPad. Same prompts, same order, same conditions as every other student you have tested this year.',
  },
  {
    title: 'It scores while you pack up',
    body: 'No scoring key, no ruler, no second-guessing a borderline form. The standard score is there when the student stands up.',
  },
  {
    title: 'The write-up is already written',
    body: 'Percentile ranks, the normal curve, and goal language you can move straight into the evaluation.',
  },
];
---

<Base
  title="Concept B"
  description="Concept B for the Psymark redesign: a practitioner-first direction that leads with caseload pressure and the time VMAT gives back."
  noindex
  bodyClass="font-humanist"
>
  <header class="absolute inset-x-0 top-0 z-40">
    <div class="mx-auto flex h-[72px] max-w-[1240px] items-center justify-between px-6">
      <a href="/concepts/" class="font-display text-xl font-extrabold tracking-tight text-navy">
        Psymark
      </a>
      <nav class="hidden items-center gap-8 md:flex">
        {NAV.map((n) => (
          <span class="text-[15px] font-medium text-navy/70 transition-colors hover:text-navy">
            {n.label}
          </span>
        ))}
      </nav>
      <a
        href={STORE_URL}
        class="rounded-brand bg-navy px-5 py-2.5 text-[15px] font-semibold text-white transition-transform active:scale-[0.98]"
      >
        Buy VMAT
      </a>
    </div>
  </header>

  <main id="main">
    {/* 1. HERO: left-stacked over an emerald wash, asset bleeds below ------ */}
    <section class="bg-emerald-wash pt-[72px]">
      <div class="mx-auto max-w-[1240px] px-6 pb-16 pt-20">
        <h1
          class="max-w-[15ch] font-display text-5xl font-extrabold leading-[0.98] tracking-tight text-navy md:text-7xl"
        >
          Give the evening back.
        </h1>
        <p class="mt-7 max-w-[52ch] text-lg leading-relaxed text-navy/70 md:text-xl">
          VMAT administers in minutes and scores itself, so the visual-motor
          piece of the evaluation stops following you home.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href={STORE_URL}
            class="rounded-brand bg-emerald-ink px-7 py-3.5 font-semibold text-white shadow-card transition-transform active:scale-[0.98]"
          >
            Buy VMAT
          </a>
          <a
            href="#how"
            class="rounded-brand border border-navy/15 px-7 py-3.5 font-semibold text-navy transition-colors hover:border-navy/40"
          >
            See how it scores
          </a>
        </div>
      </div>

      <div class="mx-auto max-w-[1240px] px-6">
        <div class="grid items-end gap-8 md:grid-cols-12">
          <div class="md:col-span-5">
            <Image
              src={ipad}
              alt="VMAT results on iPad: the student's standard score plotted on a normal curve beside percentile ranks."
              widths={[380, 520, 760]}
              sizes="(max-width: 768px) 90vw, 400px"
              loading="eager"
              class="w-full translate-y-px rounded-t-brand shadow-lift"
            />
          </div>
          <div class="pb-14 md:col-span-6 md:col-start-7">
            <p class="font-display text-2xl font-bold leading-snug text-navy md:text-3xl">
              Forty students on the caseload. The test should not be the slow part.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 2. THREE BEATS: staggered offsets, deliberately not equal cards ----- */}
    <section id="how" class="mx-auto max-w-[1240px] px-6 py-24">
      <ol class="space-y-16 md:space-y-24">
        {beats.map((beat, i) => (
          <li
            class="grid gap-6 md:grid-cols-12"
            style={`--i:${i}`}
            data-reveal
          >
            <div class={`md:col-span-7 ${i === 1 ? 'md:col-start-4' : i === 2 ? 'md:col-start-6' : ''}`}>
              <h2 class="font-display text-3xl font-bold tracking-tight text-navy md:text-5xl">
                {beat.title}
              </h2>
              <p class="mt-4 max-w-[54ch] text-lg leading-relaxed text-slate">{beat.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* 3. PROOF STRIP: full-bleed photograph with the claim over it -------- */}
    <section class="relative isolate overflow-hidden">
      {/* TODO: replace with real photography of a practitioner testing a student. */}
      <img
        src="https://picsum.photos/seed/psymark-school-ot-session/2000/900"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-navy/80"></div>
      <div class="mx-auto max-w-[1240px] px-6 py-28">
        <p
          class="max-w-[22ch] font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white md:text-6xl"
        >
          Same protocol for every student, every time.
        </p>
        <p class="mt-6 max-w-[50ch] text-lg leading-relaxed text-white/75">
          Digital administration removes the examiner drift that paper forms
          quietly introduce between raters and between sites.
        </p>
      </div>
    </section>

    {/* 4. VOICES: horizontal scroll-snap, breadth over depth --------------- */}
    <section class="py-24">
      <div class="mx-auto max-w-[1240px] px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight text-navy md:text-4xl">
          From the first practitioners using it
        </h2>
      </div>
      <div
        class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-4 [scrollbar-width:thin]"
      >
        <div class="shrink-0 md:w-[calc((100vw-1240px)/2)]"></div>
        {testimonials.map((t) => (
          <figure
            class="w-[86vw] max-w-[420px] shrink-0 snap-start rounded-brand bg-mist p-8"
          >
            <blockquote class="text-lg leading-relaxed text-navy">“{t.data.quote}”</blockquote>
            <figcaption class="mt-7 flex items-center gap-3.5">
              {t.data.photo && (
                <Image
                  src={t.data.photo}
                  alt=""
                  width={44}
                  height={44}
                  class="h-11 w-11 rounded-full object-cover"
                />
              )}
              <span class="text-sm leading-tight">
                <span class="block font-semibold text-navy">{t.data.name}</span>
                <span class="block text-slate">
                  {t.data.role}, {t.data.credentials}
                </span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* 5. CLOSE: full-bleed emerald band ----------------------------------- */}
    <section class="bg-emerald-ink">
      <div
        class="mx-auto flex max-w-[1240px] flex-col items-start gap-8 px-6 py-20 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <h2
            class="max-w-[18ch] font-display text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
          >
            Your first hundred tests are free.
          </h2>
          <p class="mt-4 max-w-[46ch] leading-relaxed text-white/80">
            Enough to run it across a real caseload before deciding anything.
          </p>
        </div>
        <a
          href={STORE_URL}
          class="shrink-0 rounded-brand bg-white px-8 py-4 font-semibold text-emerald-ink transition-transform active:scale-[0.98]"
        >
          Buy VMAT
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-[1240px] px-6 py-10 text-sm text-slate">
      Concept B of 3. Internal review only.
      <a href="/concepts/" class="ml-2 font-medium text-emerald-ink underline">Back to all concepts</a>
    </div>
  </footer>
</Base>
