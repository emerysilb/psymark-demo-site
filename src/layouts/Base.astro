---
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import { url } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />

    {/* Self-hosted and subset by Astro. No external font requests. */}
    <Font cssVariable="--font-jakarta" preload />
    <Font cssVariable="--font-plex-mono" />

    <Seo {...Astro.props} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-navy-700 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
