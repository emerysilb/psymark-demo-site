---
import { COMPANY, SITE, url } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div
    class="psy-container flex flex-wrap items-center gap-6 py-10"
  >
    <img src={url("/img/logo.png")} alt={SITE.name} width="230" height="53" class="h-[22px] w-auto" />
    <div class="flex-1"></div>
    <span class="text-sm text-slate-500">&copy; {year} {COMPANY.legalName}</span>
    <a href={`mailto:${COMPANY.email}`} class="text-sm font-medium text-green-700 hover:text-green-800">
      {COMPANY.email}
    </a>
    <a
      href={`tel:+1${COMPANY.phone.replace(/\D/g, '')}`}
      class="font-mono text-sm text-slate-500 hover:text-navy-700"
    >
      {COMPANY.phone}
    </a>
  </div>
</footer>
