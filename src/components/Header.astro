---
import { NAV, STORE_URL, CTA, SITE, url } from '../consts';

// Marks the current nav item. '/' has to match exactly or it would light up on
// every page.
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b border-slate-200 bg-white/88 backdrop-blur-sm"
>
  <div class="psy-container">
    <div class="flex h-[60px] items-center gap-8 md:h-[72px]">
      <a href={url("/")} class="flex items-center" aria-label={`${SITE.name} home`}>
        <img
          src={url("/img/logo.png")}
          alt={SITE.name}
          width="230"
          height="53"
          class="block h-[26px] w-auto"
        />
      </a>

      {/* Desktop nav. Below `md` it moves to its own row underneath. */}
      <nav class="ml-4 hidden items-center gap-7 md:flex" aria-label="Main">
        {
          NAV.map(({ label, href }) => (
            <a
              href={url(href)}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class:list={[
                'text-[15px] transition-colors',
                isCurrent(href)
                  ? 'border-b-2 border-green-600 pb-0.5 font-semibold text-navy-700'
                  : 'font-medium text-slate-600 hover:text-navy-700',
              ]}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <div class="flex-1"></div>

      <a
        href={STORE_URL}
        class="inline-flex h-10 flex-none items-center rounded-md bg-green-700 px-5 text-[15px] font-semibold text-white shadow-brand-sm transition-colors hover:bg-green-800 active:bg-green-900"
      >
        {CTA.primary}
      </a>
    </div>

    <nav class="-mt-1 flex gap-6 overflow-x-auto pb-3 md:hidden" aria-label="Main">
      {
        NAV.map(({ label, href }) => (
          <a
            href={url(href)}
            aria-current={isCurrent(href) ? 'page' : undefined}
            class:list={[
              'shrink-0 text-sm',
              isCurrent(href) ? 'font-semibold text-navy-700' : 'font-medium text-slate-600',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
